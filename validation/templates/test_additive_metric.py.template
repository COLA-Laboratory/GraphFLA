@pytest.mark.literature_case("study.metric.v1", role="paper_result")
def test_printed_result(fitted_population):
    # Use this role ONLY if preprocessing, coding and estimator match.
    assert_case_matches("study.metric.v1", fitted_population["public_summary"])


@pytest.mark.literature_case("study.metric.equation.v1", role="independent_check")
def test_fitted_components(fitted_population):
    actual, reference = fitted_population["actual"], fitted_population["reference"]
    assert actual["rank"] == reference["rank"]
    # Align coefficient names/reference states before comparing vectors.
    assert actual["coefficients"] == pytest.approx(reference["coefficients"])
    assert actual["residuals"] == pytest.approx(reference["residuals"])
    # Compare numerator and denominator separately, not only their quotient.
    assert actual["roughness"] == pytest.approx(reference["roughness"])
    assert actual["slope"] == pytest.approx(reference["slope"])


